---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import { site, getImage, whatsappHref } from '../data/index.js';

const { title, description = site.description, image = 'black-garlic-bulbs.jpg', noindex = false, overlay = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const whatsapp = whatsappHref();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const showFab = !Astro.url.pathname.slice(base.length).startsWith('/contact');
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
const socialImage = site.url ? new URL(getImage(image).src, site.url).href : undefined;

// Structured data uses confirmed information only.
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.description,
  ...(site.url && { url: site.url }),
  address: {
    '@type': 'PostalAddress',
    ...(site.location.streetAddress && { streetAddress: site.location.streetAddress }),
    addressLocality: site.location.town,
    addressRegion: site.location.state,
    addressCountry: 'IN',
  },
  ...(site.contact.email && { email: site.contact.email }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#173F35" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Marks the page as scripted so scroll-reveal styles only apply when they can be undone */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlay} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {
      showFab && (
        <a class="fab" href={whatsapp || '/contact/#quote-form'} target={whatsapp ? '_blank' : undefined} rel={whatsapp ? 'noopener' : undefined}>
          {whatsapp ? 'Enquire on WhatsApp' : 'Request a Quote'} <Arrow />
        </a>
      )
    }
    <script is:inline>
      (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Page headlines rise word by word, each from behind its own edge
        document.querySelectorAll('.page-hero h1, [data-split]').forEach(function (heading) {
          var count = 0;
          (function walk(node) {
            Array.prototype.slice.call(node.childNodes).forEach(function (child) {
              if (child.nodeType === 1) return walk(child);
              if (child.nodeType !== 3) return;
              var fragment = document.createDocumentFragment();
              child.textContent.split(/(\s+)/).forEach(function (part) {
                if (!part) return;
                if (/^\s+$/.test(part)) return fragment.appendChild(document.createTextNode(' '));
                var word = document.createElement('span');
                var inner = document.createElement('span');
                word.className = 'word';
                inner.style.setProperty('--i', count++);
                inner.textContent = part;
                word.appendChild(inner);
                fragment.appendChild(word);
              });
              node.replaceChild(fragment, child);
            });
          })(heading);
          heading.classList.add('is-split');
        });

        // The page-hero shapes and reel still move a little slower than the page
        var pageHero = document.querySelector('.page-hero');
        if (pageHero && !reduceMotion) {
          var onMove = function () {
            if (window.scrollY < window.innerHeight * 1.3) pageHero.style.setProperty('--sy', window.scrollY + 'px');
          };
          window.addEventListener('scroll', onMove, { passive: true });
          onMove();
        }

        var items = document.querySelectorAll('[data-reveal]');
        var show = function (el) {
          el.classList.add('is-visible');
        };
        if (!('IntersectionObserver' in window)) {
          items.forEach(show);
        } else {
          var observer = new IntersectionObserver(
            function (entries) {
              var index = 0;
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                var el = entry.target;
                el.style.transitionDelay = Math.min(index++, 6) * 80 + 'ms';
                show(el);
                observer.unobserve(el);
                setTimeout(function () {
                  el.style.transitionDelay = '';
                }, 1200);
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          items.forEach(function (el) {
            observer.observe(el);
          });
        }

        var fab = document.querySelector('.fab');
        if (fab) {
          var onScroll = function () {
            var nearEnd = window.innerHeight + window.scrollY > document.documentElement.scrollHeight - 320;
            fab.classList.toggle('is-shown', window.scrollY > 640 && !nearEnd);
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      })();
    </script>
    <script>
      // Scroll-linked effects (GSAP ScrollTrigger) and entrances and interactions (Motion)
      import '../scripts/scroll-effects';
      import '../scripts/interactions';
    </script>
  </body>
</html>
