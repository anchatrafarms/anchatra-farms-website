---
// Scroll-built journey: a line drawing that assembles itself as the page scrolls, from the fields
// around Oddanchatram to a ship leaving port. The section pins while the scene pans sideways.
// Without JavaScript, or with reduced motion, it shows the finished drawing as a strip with the
// five steps listed underneath.

import { round, tree } from './art.js';

// Wording here repeats commitments made elsewhere on the site. Confirmed information only.
const chapters = [
  {
    label: 'Oddanchatram',
    title: 'Rooted in Oddanchatram',
    text: 'A market town in the Dindigul district of Tamil Nadu, and the place our name comes from.',
  },
  {
    label: 'The market',
    title: 'Sourced through people we know',
    text: 'Sourcing begins with our founder’s personal relationships with shop owners in the Oddanchatram vegetable market.',
  },
  {
    label: 'Packing',
    title: 'Packed to your requirement',
    text: 'Pack size, labelling and handling are discussed with you for each order.',
  },
  {
    label: 'Paperwork',
    title: 'Set out in writing',
    text: 'Specification, packaging and the documents that apply are agreed before an order is confirmed.',
  },
  {
    label: 'Dispatch',
    title: 'On its way to you',
    text: 'Once the order is confirmed, we follow the fulfilment arrangements agreed with you.',
  },
];

const two = (n) => String(n).padStart(2, '0');

// The scene is drawn in a 5400 × 600 box with the ground at y = 470. Each station is 960 wide.
// STOPS are the points in the scroll (0–1) at which each station sits in the middle of the screen;
// a station builds during the stretch of scroll just before its stop.
const STOPS = [0.16, 0.345, 0.53, 0.715, 0.9];
const BUILD = 0.15;
const stationX = (i) => i * 960;

// Timing for one element: `from` and `to` are fractions (0–1) of its station's build window.
const win = (i, from = 0, to = 1) => {
  const start = STOPS[i] - BUILD;
  return `--a:${(start + from * BUILD).toFixed(4)};--b:${(start + to * BUILD).toFixed(4)}`;
};
const draw = (i, from, to, extra = '') => ({ class: `d ${extra}`, pathLength: 1, style: win(i, from, to) });
const rise = (i, from, to, extra = '') => ({ class: `r ${extra}`, style: win(i, from, to) });
const grow = (i, from, to, extra = '') => ({ class: `g ${extra}`, style: win(i, from, to) });
const fade = (i, from, to, extra = '') => ({ class: `f ${extra}`, style: win(i, from, to) });
const pop = (i, from, to, extra = '') => ({ class: `p ${extra}`, style: win(i, from, to) });

// ── Far ridge, running behind the whole scene ────────────────────────────────
const ridgePoints = [];
for (let x = -1600; x <= 7000; x += 200) {
  ridgePoints.push([x, round(372 - 52 * Math.sin(x / 310) - 28 * Math.sin(x / 127 + 1))]);
}
const ridge =
  `M-1600 470 L${ridgePoints[0].join(' ')} ` +
  ridgePoints
    .slice(1)
    .map(([x, y], k) => {
      const [px, py] = ridgePoints[k];
      return `Q${px} ${py} ${(px + x) / 2} ${round((py + y) / 2)}`;
    })
    .join(' ') +
  ' L7000 470 Z';
const clouds = [
  [140, 150, 1],
  [1180, 96, 1.25],
  [2050, 170, 0.9],
  [2980, 104, 1.15],
  [3760, 150, 1],
  [4900, 110, 1.3],
];

// ── Station 1: moringa trees ─────────────────────────────────────────────────
const trees = [tree(230, 470, 220), tree(840, 470, 160)];
const sprouts = [360, 412, 464, 516, 568];

// ── Station 2: market stalls ─────────────────────────────────────────────────
const stall = (x, wd, top, tone) => {
  const n = 6;
  const r = (wd + 28) / (2 * n);
  const stripes = [];
  for (let k = 1; k < n; k++) {
    stripes.push(`M${round(x + 10 + (k * (wd - 20)) / n)} ${top} L${round(x - 14 + (k * (wd + 28)) / n)} ${top + 46}`);
  }
  const produce = [];
  const count = Math.floor((wd - 40) / 26);
  for (let k = 0; k < count; k++) produce.push([x + 26 + k * 26, 399]);
  for (let k = 0; k < count - 1; k++) produce.push([x + 39 + k * 26, 379]);
  return {
    tone,
    awning: `M${x - 14} ${top + 46} L${x + 10} ${top} H${x + wd - 10} L${x + wd + 14} ${top + 46} Z`,
    scallops: `M${x - 14} ${top + 46} ` + Array.from({ length: n }, () => `a${round(r)} ${round(r)} 0 0 0 ${round(2 * r)} 0`).join(' '),
    stripes: stripes.join(' '),
    posts: `M${x + 12} ${top + 46} V412 M${x + wd - 12} ${top + 46} V412`,
    counter: { x: x + 4, y: 412, width: wd - 8, height: 58 },
    plank: `M${x + 4} 434 H${x + wd - 4}`,
    produce,
  };
};
const stalls = [stall(150, 210, 300, 'terra'), stall(385, 220, 262, 'sand'), stall(630, 210, 300, 'sage')];
const baskets = [48, 868];

// ── Station 3: cartons on a pallet ───────────────────────────────────────────
const cartons = [
  [300, 396], [388, 396], [476, 396], [564, 396],
  [344, 334], [432, 334], [520, 334],
  [388, 272], [476, 272],
];

// ── Station 5: containers, and the dotted route out to sea ───────────────────
const containers = [
  [230, 426, 'terra'], [334, 426, 'sage'],
  [230, 382, 'sand'], [334, 382, 'terra'],
  [230, 338, 'sage'],
];
const deck = [
  [672, 396, 'sand'], [746, 396, 'terra'], [820, 396, 'sage'],
  [709, 352, 'terra'], [783, 352, 'sand'],
];
const routeDots = Array.from({ length: 16 }, (_, k) => {
  const t = (k + 1) / 17;
  const b = (p0, p1, p2, p3) => (1 - t) ** 3 * p0 + 3 * (1 - t) ** 2 * t * p1 + 3 * (1 - t) * t * t * p2 + t ** 3 * p3;
  return [round(b(980, 1090, 1330, 1500)), round(b(392, 190, 150, 262))];
});
const waves = (y) => `M440 ${y} q20 -9 40 0 ` + Array.from({ length: 44 }, () => 't40 0').join(' ');
---

<section class="journey on-dark" data-journey data-stops={JSON.stringify(STOPS)} aria-labelledby="journey-heading">
  <div class="journey__stage">
    <div class="container journey__head">
      <p class="eyebrow">From Oddanchatram to your market</p>
      <h2 id="journey-heading">An export journey, built <em>one clear step at a time.</em></h2>
    </div>

    <div class="journey__scene" aria-hidden="true">
      <div class="journey__track" data-journey-track>
        <svg class="art" viewBox="0 0 5400 600" data-journey-art focusable="false">
          <defs>
            <clipPath id="journey-sea"><rect x="600" y="440" width="2200" height="160"></rect></clipPath>
          </defs>

          <!-- Far layer: moves a little slower than the rest, for depth -->
          <g class="far">
            <path class="ridge" d={ridge}></path>
            {
              clouds.map(([x, y, s]) => (
                <path
                  class="cloud"
                  transform={`translate(${x} ${y}) scale(${s})`}
                  d="M0 30 q-22 -2 -20 -20 q2 -16 22 -12 q8 -24 36 -18 q14 -20 40 -6 q30 -6 34 22 q20 2 18 18 q-2 16 -22 16 Z"
                />
              ))
            }
          </g>

          <!-- Ground, and the route that draws along it as the page scrolls -->
          <path class="ground" d="M-1600 470 H4440"></path>
          <path class="d route" pathLength="1" style={`--a:${STOPS[0]};--b:${STOPS[4]}`} d="M480 470 H4320"></path>

          <!-- 1. Oddanchatram: hills, fields and moringa trees -->
          <g transform={`translate(${stationX(0)} 0)`}>
            <path {...draw(0, 0, 0.6, 'soft')} d="M30 470 C150 350 250 280 350 336 C430 244 560 226 660 318 C740 276 850 360 930 470"></path>
            <circle class="glow" cx="700" cy="150" r="44" style={win(0, 0.2, 0.7)}></circle>
            <circle {...draw(0, 0.15, 0.7)} cx="700" cy="150" r="44"></circle>
            <path {...draw(0, 0.3, 0.75)} d="M606 470 V398 H716 V470 M592 404 L661 352 L730 404 M650 470 V430 H674 V470"></path>
            {
              trees.map((t, k) => (
                <g>
                  <path {...draw(0, 0.1 + k * 0.15, 0.6 + k * 0.15)} d={t.trunk} />
                  {t.branches.map((d, b) => (
                    <path {...draw(0, 0.3 + k * 0.15 + b * 0.04, 0.7 + k * 0.15 + b * 0.04, 'thin')} d={d} />
                  ))}
                  {t.leaves.map(([x, y], l) => (
                    <ellipse {...pop(0, 0.45 + k * 0.12 + l * 0.006, 0.7 + k * 0.12 + l * 0.006, 'leaf')} cx={x} cy={y} rx="10" ry="5" />
                  ))}
                </g>
              ))
            }
            {
              sprouts.map((x, k) => (
                <path
                  {...grow(0, 0.5 + k * 0.07, 0.75 + k * 0.06, 'sprout')}
                  d={`M${x} 470 v-24 M${x} 458 q-13 -2 -15 -15 M${x} 458 q13 -2 15 -15`}
                />
              ))
            }
          </g>

          <!-- 2. The vegetable market -->
          <g transform={`translate(${stationX(1)} 0)`}>
            {
              stalls.map((s, k) => (
                <g>
                  <path {...draw(1, 0.05 + k * 0.12, 0.4 + k * 0.12)} d={s.posts} />
                  <rect {...draw(1, 0.1 + k * 0.12, 0.5 + k * 0.12, 'panel')} {...s.counter} rx="4" />
                  <path {...draw(1, 0.2 + k * 0.12, 0.5 + k * 0.12, 'soft thin')} d={s.plank} />
                  <g {...rise(1, 0.25 + k * 0.12, 0.55 + k * 0.12)}>
                    <path class={`awning tone-${s.tone}`} d={s.awning} />
                    <path class="thin soft" d={s.stripes} />
                    <path d={s.scallops} />
                  </g>
                  {s.produce.map(([x, y], n) => (
                    <circle {...pop(1, 0.5 + k * 0.1 + n * 0.012, 0.7 + k * 0.1 + n * 0.012, `dot tone-${s.tone}`)} cx={x} cy={y} r="11" />
                  ))}
                </g>
              ))
            }
            {
              baskets.map((x, k) => (
                <g {...rise(1, 0.55 + k * 0.2, 0.8 + k * 0.2)}>
                  <path class="dot tone-terra" d={`M${x + 4} 436 q31 -40 62 0 Z`} />
                  <path class="panel" d={`M${x} 436 H${x + 70} L${x + 60} 470 H${x + 10} Z`} />
                  <path class="thin soft" d={`M${x + 4} 448 H${x + 66} M${x + 7} 459 H${x + 63}`} />
                </g>
              ))
            }
          </g>

          <!-- 3. Packing -->
          <g transform={`translate(${stationX(2)} 0)`}>
            <path {...draw(2, 0, 0.5)} d="M160 470 V254 M800 470 V254"></path>
            <path {...draw(2, 0.15, 0.6)} d="M120 264 L480 172 L840 264"></path>
            <path {...draw(2, 0.3, 0.7, 'soft thin')} d="M160 286 L480 204 L800 286"></path>
            <rect {...draw(2, 0.2, 0.5, 'panel')} x="286" y="458" width="378" height="12" rx="3"></rect>
            {
              cartons.map(([x, y], k) => (
                <g {...rise(2, 0.3 + k * 0.065, 0.48 + k * 0.065)}>
                  <rect class="carton" x={x} y={y} width="86" height="62" rx="4" />
                  <path class="thin soft" d={`M${x + 43} ${y} v18`} />
                  <rect class="tag" x={x + 12} y={y + 34} width="30" height="16" rx="2" />
                </g>
              ))
            }
            <g {...rise(2, 0.6, 0.85)}>
              <rect class="panel" x="690" y="452" width="92" height="18" rx="4"></rect>
              <path d="M772 452 V384"></path>
              <circle class="panel" cx="772" cy="368" r="17"></circle>
              <path class="thin" d="M772 368 l7 -9"></path>
              <path class="sack" d="M700 452 q-9 -40 10 -54 h36 q19 14 10 54 Z M712 398 q16 -12 32 0"></path>
            </g>
            <g {...rise(2, 0.7, 0.95)}>
              <rect class="carton" x="186" y="408" width="78" height="62" rx="4"></rect>
              <rect class="carton" x="194" y="350" width="62" height="58" rx="4"></rect>
              <path class="thin soft" d="M225 408 v18 M225 350 v16"></path>
            </g>
          </g>

          <!-- 4. Paperwork -->
          <g transform={`translate(${stationX(3)} 0)`}>
            <path {...fade(3, 0.1, 0.4, 'stem')} d="M480 398 V470"></path>
            <rect {...draw(3, 0, 0.45, 'sheet-back')} x="370" y="118" width="220" height="280" rx="10" transform="rotate(5 480 258)"></rect>
            <rect {...draw(3, 0.1, 0.55, 'sheet')} x="370" y="118" width="220" height="280" rx="10"></rect>
            <path {...draw(3, 0.3, 0.5, 'bold')} d="M400 160 H500"></path>
            {
              [206, 246, 286].map((y, k) => (
                <g>
                  <path {...draw(3, 0.4 + k * 0.1, 0.6 + k * 0.1, 'soft')} d={`M440 ${y} H560`} />
                  <path {...draw(3, 0.5 + k * 0.1, 0.68 + k * 0.1, 'tick')} d={`M398 ${y - 2} l8 9 l15 -18`} />
                </g>
              ))
            }
            <path {...draw(3, 0.75, 0.95, 'thin')} d="M400 356 q9 -24 18 0 t18 0 t18 0 t22 -8"></path>
            <g {...pop(3, 0.8, 1)}>
              <circle class="seal" cx="544" cy="344" r="31"></circle>
              <circle class="thin seal-ring" cx="544" cy="344" r="22"></circle>
              <path class="seal-tick" d="M533 344 l8 9 l14 -17"></path>
            </g>
            {
              [
                ['Specification', 96, 170],
                ['Packaging', 632, 220],
                ['Documents', 110, 300],
              ].map(([text, x, y], k) => (
                <g {...rise(3, 0.45 + k * 0.14, 0.7 + k * 0.14)}>
                  <path class="thin soft" d={x < 480 ? `M${x + 218} ${y + 21} H370` : `M590 ${y + 21} H${x}`} />
                  <rect class="chip" x={x} y={y} width="218" height="42" rx="21" />
                  <text class="chip-text" x={x + 109} y={y + 28}>{text}</text>
                </g>
              ))
            }
          </g>

          <!-- 5. Dispatch: quay, crane and ship -->
          <g transform={`translate(${stationX(4)} 0)`}>
            <path {...draw(4, 0, 0.3)} d="M600 470 V530"></path>
            {
              containers.map(([x, y, tone], k) => (
                <g {...rise(4, 0.1 + k * 0.08, 0.3 + k * 0.08)}>
                  <rect class={`box tone-${tone}`} x={x} y={y} width="100" height="44" rx="3" />
                  <path class="thin soft" d={`M${x + 20} ${y + 7} v30 M${x + 40} ${y + 7} v30 M${x + 60} ${y + 7} v30 M${x + 80} ${y + 7} v30`} />
                </g>
              ))
            }
            <path {...draw(4, 0.15, 0.6)} d="M470 470 V200 M570 470 V200 M470 300 H570 M470 300 L570 200 M470 400 L570 300"></path>
            <path {...draw(4, 0.4, 0.75)} d="M410 200 H800 M520 200 V146 L410 200 M520 146 L800 200"></path>
            <g {...fade(4, 0.6, 0.75)}>
              <rect class="panel" x="686" y="200" width="34" height="14" rx="3"></rect>
              <g class="lower" style={win(4, 0.65, 1)}>
                <path class="thin" d="M703 150 V300"></path>
                <rect class="box tone-terra" x="656" y="300" width="94" height="40" rx="3"></rect>
              </g>
            </g>
            <g {...rise(4, 0.35, 0.7)}>
              <g class="bob">
                <path class="hull" d="M630 440 H974 L944 506 H662 Z"></path>
                <path class="thin soft" d="M650 462 H958"></path>
                <path class="panel" d="M900 440 V378 H952 V440 M912 378 V352 H934 V378"></path>
                <path class="thin soft" d="M912 396 h28 M912 412 h28"></path>
                {deck.map(([x, y, tone]) => <rect class={`box tone-${tone}`} x={x} y={y} width="74" height="44" rx="3" />)}
              </g>
            </g>
            <g clip-path="url(#journey-sea)">
              <path {...fade(4, 0.2, 0.6, 'wave')} d={waves(506)}></path>
              <path {...fade(4, 0.3, 0.7, 'wave wave--back')} d={waves(544)}></path>
            </g>
            {routeDots.map(([x, y], k) => <circle {...fade(4, 0.72 + k * 0.016, 0.8 + k * 0.016, 'route-dot')} cx={x} cy={y} r="4.5" />)}
            <g {...pop(4, 0.94, 1)}>
              <circle class="pin-ring" cx="1524" cy="282" r="26"></circle>
              <circle class="pin" cx="1524" cy="282" r="10"></circle>
            </g>
          </g>

          <!-- The truck carries the packed order from the pack house to the quay -->
          <g class="f" style="--a:0.5;--b:0.54">
            <g class="truck" style="--a:0.55;--b:0.87">
              <rect class="carton" x="2620" y="386" width="124" height="66" rx="5"></rect>
              <path class="thin soft" d="M2650 396 v46 M2682 396 v46 M2714 396 v46"></path>
              <path class="cab" d="M2750 452 V408 H2780 L2802 432 V452 Z"></path>
              <path class="thin" d="M2760 418 H2777 L2790 432 H2760 Z"></path>
              <path d="M2614 453 H2806"></path>
              {
                [2652, 2772].map((x) => (
                  <g class="wheel">
                    <circle class="tyre" cx={x} cy="456" r="14" />
                    <path class="thin" d={`M${x - 9} 456 h18 M${x} 447 v18`} />
                  </g>
                ))
              }
            </g>
          </g>

          <!-- A marker and a label on the route for each station -->
          {
            chapters.map((chapter, i) => (
              <g {...fade(i, 0.55, 0.9)}>
                <circle class="node" cx={stationX(i) + 480} cy="470" r="9" />
                <text
                  class:list={['label', i === chapters.length - 1 && 'label--end']}
                  x={stationX(i) + (i === chapters.length - 1 ? 572 : 480)}
                  y="532"
                >
                  {two(i + 1)} · {chapter.label}
                </text>
              </g>
            ))
          }
        </svg>
      </div>
    </div>

    <div class="container journey__foot">
      <ol class="journey__captions">
        {
          chapters.map((chapter, i) => (
            <li class:list={['journey__caption', i === 0 && 'is-active']} data-journey-caption>
              <span class="journey__num" aria-hidden="true">{two(i + 1)}</span>
              <h3>{chapter.title}</h3>
              <p>{chapter.text}</p>
            </li>
          ))
        }
      </ol>
      <ol class="journey__tabs">
        {
          chapters.map((chapter, i) => (
            <li>
              <button
                type="button"
                class="journey__tab"
                data-journey-tab
                style={`--s:${(STOPS[i] - (STOPS[1] - STOPS[0]) / 2).toFixed(4)}`}
                aria-label={`Step ${i + 1}: ${chapter.title}`}
              >
                <span class="journey__tab-bar" aria-hidden="true">
                  <span class="journey__tab-fill" />
                </span>
                <span class="journey__tab-num" aria-hidden="true">{two(i + 1)}</span>
                <span class="journey__tab-name" aria-hidden="true">{chapter.label}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // One number drives the whole scene: --p, how far the section has been scrolled (0–1).
  // Every drawn element works out its own state from --p in CSS; this script only sets it,
  // pans the scene so the current station is centred, and switches the caption.
  const section = document.querySelector<HTMLElement>('[data-journey]');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (section && motionOk.matches) {
    const scene = section.querySelector<HTMLElement>('.journey__scene')!;
    const track = section.querySelector<HTMLElement>('[data-journey-track]')!;
    const art = section.querySelector<SVGElement>('[data-journey-art]')!;
    const captions = [...section.querySelectorAll('[data-journey-caption]')];
    const tabs = [...section.querySelectorAll<HTMLElement>('[data-journey-tab]')];
    const stops: number[] = JSON.parse(section.dataset.stops || '[]');
    const first = stops[0];
    const span = stops[stops.length - 1] - first;
    const clamp = (n: number) => Math.max(0, Math.min(n, 1));

    let target = 0;
    let shown = -1;
    let active = -1;
    let looping = false;

    // The scene starts building while the section is still arriving, 60% of a screen early
    const lead = () => window.innerHeight * 0.6;
    const travel = () => section.offsetHeight - window.innerHeight + lead();
    const measure = () => clamp((lead() - section.getBoundingClientRect().top) / travel());

    const render = () => {
      const scale = art.clientHeight / 600;
      // After the last stop the view carries on a little, out over the water with the ship
      const centre =
        480 +
        clamp((shown - first) / span) * 960 * (stops.length - 1) +
        clamp((shown - first - span) / (1 - first - span)) * 250;
      section.style.setProperty('--p', shown.toFixed(4));
      track.style.transform = `translate3d(${(scene.clientWidth / 2 - centre * scale).toFixed(1)}px,0,0)`;

      const index = Math.round(clamp((shown - first) / span) * (stops.length - 1));
      if (index !== active) {
        active = index;
        captions.forEach((caption, i) => caption.classList.toggle('is-active', i === index));
        tabs.forEach((tab, i) => {
          if (i === index) tab.setAttribute('aria-current', 'step');
          else tab.removeAttribute('aria-current');
        });
      }
    };

    // Ease towards the scroll position so the drawing glides instead of ticking with the wheel
    const step = () => {
      shown += (target - shown) * 0.14;
      if (Math.abs(target - shown) < 0.0004) {
        shown = target;
        looping = false;
      } else {
        requestAnimationFrame(step);
      }
      render();
    };

    const onMove = () => {
      target = measure();
      if (!looping) {
        looping = true;
        requestAnimationFrame(step);
      }
    };

    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        const top = section.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: top + stops[i] * travel() - lead() + 2, behavior: 'smooth' });
      }),
    );

    window.addEventListener('scroll', onMove, { passive: true });
    window.addEventListener('resize', () => {
      onMove();
      render();
    });
    shown = target = measure(); // no glide on load: start wherever the page already is
    render();
  }
</script>

<style>
  .journey {
    --p: 1; /* finished drawing unless the script is driving it */
    --ink: var(--sand);
    --ink-soft: rgba(246, 242, 233, 0.4);
    position: relative;
    background:
      radial-gradient(60rem 30rem at 12% 0%, rgba(167, 181, 154, 0.14), transparent 62%),
      radial-gradient(50rem 26rem at 100% 100%, rgba(185, 101, 69, 0.2), transparent 62%), var(--green-deep);
  }
