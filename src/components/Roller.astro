---
// Small illustrated produce character used as the scroll marker and as decoration.
// `kind` picks the drawing: onion, tomato, garlic (black garlic) or moringa (a leaf).
// The face shuts its eyes while an ancestor has the class "is-rolling". Decorative only.
const { kind = 'onion', size = 40, face = true } = Astro.props;
---

<svg class:list={['roller', `roller--${kind}`]} width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  {
    kind === 'onion' && (
      <>
        <path d="M29 15c-1-6-2-9-4-12M32 14c0-5 1-8 2-12M35 15c1-5 3-7 5-10" stroke="#c9a36e" stroke-width="2.2" stroke-linecap="round" />
        <path d="m29 59-2 4M32 59.5V64M35 59l2 4" stroke="#c9a36e" stroke-width="1.6" stroke-linecap="round" />
        <path d="M32 13C21 17 8 26 8 39c0 12 11 20 24 20s24-8 24-20c0-13-13-22-24-26Z" fill="#a2445a" />
        <path d="M32 13c11 4 24 13 24 26 0 12-11 20-24 20 9-5 15-12 15-21 0-10-6-19-15-25Z" fill="#7d2f45" opacity="0.6" />
        <path
          d="M32 14c-10 8-15 18-14 28 1 8 7 14 14 17M32 14c5 10 7 20 6 30-1 7-3 12-6 15"
          stroke="#e3a3b0"
          stroke-width="1.3"
          stroke-linecap="round"
          opacity="0.55"
        />
        <path d="M16 31c1-5 4-8 8-10" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity="0.55" />
      </>
    )
  }
  {
    kind === 'tomato' && (
      <>
        <path d="M32 17C19 17 8 25 8 38s11 21 24 21 24-8 24-21-11-21-24-21Z" fill="#c8402f" />
        <path d="M32 17c13 0 24 8 24 21S45 59 32 59c9-5 15-12 15-21s-6-16-15-21Z" fill="#9e2c22" opacity="0.55" />
        <path d="M32 16v-8" stroke="#3f7a3a" stroke-width="2.6" stroke-linecap="round" />
        <path d="m32 22-10-6 7 0-4-7 7 5 7-5-4 7 7 0Z" fill="#3f7a3a" />
        <path d="M15 32c1-5 4-8 8-9" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity="0.55" />
      </>
    )
  }
  {
    kind === 'garlic' && (
      <>
        <path d="M30 14c0-5-1-8-2-11M34 14c0-5 1-8 3-10" stroke="#c9b08f" stroke-width="2.4" stroke-linecap="round" />
        <path d="m28 59-2 4M32 59.5V64M36 59l2 4" stroke="#c9b08f" stroke-width="1.6" stroke-linecap="round" />
        <path d="M32 11c-2 6-8 9-14 14-7 6-10 12-9 19 1 9 9 15 23 15s22-6 23-15c1-7-2-13-9-19-6-5-12-8-14-14Z" fill="#4a3a36" />
        <path d="M32 11c2 6 8 9 14 14 7 6 10 12 9 19-1 9-9 15-23 15 9-4 14-10 14-19 0-11-8-17-14-29Z" fill="#2b2120" opacity="0.6" />
        <path
          d="M32 13c-8 9-12 19-11 30 1 7 5 12 11 15M32 13c6 9 10 19 9 30-1 7-4 12-9 15"
          stroke="#9a8273"
          stroke-width="1.3"
          stroke-linecap="round"
          opacity="0.6"
        />
        <path d="M16 33c1-4 4-7 7-9" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity="0.35" />
      </>
    )
  }
  {
    kind === 'moringa' && (
      <>
        <path d="M32 14V5" stroke="#3f7a3a" stroke-width="2.6" stroke-linecap="round" />
        <path d="M32 12C18 20 11 32 13 44c2 9 9 15 19 15s17-6 19-15c2-12-5-24-19-32Z" fill="#5e9b4b" />
        <path d="M32 12c14 8 21 20 19 32-2 9-9 15-19 15 8-5 12-12 12-21 0-10-5-18-12-26Z" fill="#3f7a3a" opacity="0.55" />
        <path
          d="M32 15v43M32 26l-9-5M32 26l9-5M32 54l-11-7M32 54l11-7"
          stroke="#cfe5b8"
          stroke-width="1.2"
          stroke-linecap="round"
          opacity="0.5"
        />
        <path d="M18 33c1-5 4-8 7-10" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity="0.45" />
      </>
    )
  }
  {
    face && (
      <g class="roller__face">
        <circle cx="19.5" cy="45" r="3.4" fill="#ffb3a7" opacity="0.5" />
        <circle cx="44.5" cy="45" r="3.4" fill="#ffb3a7" opacity="0.5" />
        {/* eyes open: shown at rest, blinking now and then, pupils following the pointer */}
        <g class="roller__open">
          <ellipse cx="25" cy="38" rx="4.3" ry="4.9" fill="#fff" />
          <ellipse cx="39" cy="38" rx="4.3" ry="4.9" fill="#fff" />
          <g class="roller__pupils">
            <circle cx="25.4" cy="38.6" r="2.3" fill="#1f1a1a" />
            <circle cx="39.4" cy="38.6" r="2.3" fill="#1f1a1a" />
            <circle cx="26.2" cy="37.7" r="0.8" fill="#fff" />
            <circle cx="40.2" cy="37.7" r="0.8" fill="#fff" />
          </g>
        </g>
        {/* eyes squeezed shut: shown while rolling */}
        <path class="roller__shut" d="m21.5 35.5 6 2.5-6 2.5M42.5 35.5l-6 2.5 6 2.5" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
        <path class="roller__smile" d="M27.5 46.5q4.5 4.2 9 0" stroke="#fff" stroke-width="1.9" stroke-linecap="round" />
        <ellipse class="roller__gasp" cx="32" cy="48" rx="2.6" ry="3.1" fill="#fff" />
      </g>
    )
  }
</svg>
